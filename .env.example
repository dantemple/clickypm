APP_NAME=ClickyPM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# open | invite (only emails with a pending workspace invitation can sign up)
REGISTRATION_MODE=open
# Only turn on once `php artisan inertia:start-ssr` runs alongside the app.
INERTIA_SSR_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clickup
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Task attachments: "local" for development, "s3" for any S3-compatible
# service (AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO).
# For non-AWS services also set AWS_ENDPOINT (and AWS_DEFAULT_REGION=auto for R2);
# MinIO usually needs AWS_USE_PATH_STYLE_ENDPOINT=true.
ATTACHMENTS_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# GitHub module (optional). Create a GitHub App at github.com/settings/apps/new with:
#   Webhook URL      ${APP_URL}/github/webhook   (active, with the secret below)
#   Setup URL        ${APP_URL}/github/setup     (tick "Redirect on update")
#   Permissions      Repository: Contents (read), Metadata (read), Pull requests (read)
#   Subscribe to     Installation target, Pull request, Push
# Then put its URL slug (github.com/apps/<slug>) and webhook secret here.
# Behind Cloudflare, add a WAF custom rule that skips managed and custom rules for
#   http.request.uri.path eq "/github/webhook" and starts_with(http.user_agent, "GitHub-Hookshot/")
# or the WAF blocks GitHub's deliveries. The app checks each delivery's signature itself.
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Live updates (Laravel Reverb). Locally, `php artisan install:broadcasting --reverb` fills
# these in (or copy them from a teammate) and `composer run dev` starts the server. On Laravel Cloud,
# attaching a WebSockets cluster to the environment provides them.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
